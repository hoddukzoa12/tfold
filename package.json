{
  "name": "tfold",
  "version": "0.1.0",
  "private": true,
  "description": "A Chrome extension that shortens the paragraph under the pointer, in place, while you hold a key and scroll.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:store": "node scripts/build.ts --store",
    "build:dev": "node scripts/build.ts --dev",
    "package:open": "rm -f tfold-open.zip && npm run build && cd dist && zip -qrX ../tfold-open.zip .",
    "package:store": "rm -f tfold-store.zip && npm run build:store && cd dist-store && zip -qrX ../tfold-store.zip .",
    "icons": "node scripts/brand-icons.ts",
    "lint": "eslint .",
    "typecheck": "tsc && tsc -p eval",
    "test": "vitest run",
    "e2e": "npm run build && npm run build:store && playwright test",
    "perf:boot": "node e2e/boot-probe.ts",
    "fixtures:capture": "node e2e/capture-fixtures.ts",
    "eval:capture": "node eval/fold-quality/capture.ts",
    "eval:fold": "node eval/fold-quality/fold.ts",
    "eval:judge": "node eval/fold-quality/judge.ts",
    "eval:agree": "node eval/fold-quality/agree.ts",
    "eval:report": "node eval/fold-quality/report.ts",
    "eval:routing": "node eval/fold-quality/routing.ts",
    "eval:window": "node eval/fold-quality/window.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
